# Foundry project endpoint. The project MUST be in a region that supports AI red
# teaming: East US 2, France Central, Sweden Central, Switzerland West, or North
# Central US. ./part2_setup.sh provisions one and fills this in for you.
AZURE_AI_PROJECT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>

# Where VaultBot (Part 1) is running.
VAULTBOT_URL=http://localhost:3000
